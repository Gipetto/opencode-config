{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 8192,
    "prune": false,
    "reserved": 10000,
    "tail_turns": 6
  },
  "lsp": true,
  "mcp": {
    "gitnexus": {
      "command": [
        "gitnexus",
        "mcp"
      ],
      "type": "local"
    },
    "kindex": {
      "command": [
        "kin-mcp"
      ],
      "type": "local"
    },
    "postgres": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{file:secrets/postgres-url}"
      ],
      "type": "local"
    },
    "sentry": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "svelte": {
      "command": [
        "npx",
        "-y",
        "@sveltejs/mcp"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "gh auth status *": "allow",
      "gh browse *": "allow",
      "gh gist list *": "allow",
      "gh gist view *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh issue view *": "allow",
      "gh label list *": "allow",
      "gh pr checks *": "allow",
      "gh pr close *": "allow",
      "gh pr create *": "allow",
      "gh pr diff *": "allow",
      "gh pr edit *": "allow",
      "gh pr list *": "allow",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh repo list *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search *": "allow",
      "gh status *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow"
    },
    "doom_loop": "deny",
    "question": "allow",
    "skill": "allow",
    "websearch": "allow"
  },
  "plugin": [
    [
      "./plugins/kindex-compaction.js",
      {
        "configPath": "../kindex/opencode.yaml",
        "env": {
          "ANTHROPIC_BASE_URL": "http://localhost:8000",
          "OMLX_KEY": "{file:secrets/omlx-key}"
        },
        "debug": true
      }
    ]
  ],
  "provider": {
    "lmstudio": {
      "models": {},
      "name": "LM Studio (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseUrl": "http://127.0.0.1:1234/v1"
      }
    },
    "omlx": {
      "models": {
        "Qwen3.8-27B-8bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q8 (omlx)",
          "options": {}
        },
        "Qwen3.8-27B-MLX-6bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q6 (omlx)",
          "options": {},
          "variants": {}
        },
        "Qwen3.8-27B-MLX-6bit-32k": {
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q6 32k context (omlx)",
          "id": "Qwen3.8-27B-MLX-6bit-32k",
          "options": {},
          "variants": {}
        },
        "Qwen3.8-27B-MLX-4bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q4 (omlx)",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE (omlx)",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit-32k": {
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE 32k context (omlx)",
          "id": "Qwen3.6-35B-A3B-MLX-mixed-4bit",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit-64k": {
          "limit": {
            "context": 64000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE 64k context (omlx)",
          "id": "Qwen3.6-35B-A3B-MLX-mixed-4bit",
          "options": {}
        }
      },
      "name": "OMLX (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{file:secrets/omlx-api-key}",
        "baseURL": "http://127.0.0.1:8000/v1"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".turbo/**",
      ".next/**",
      ".sveltekit/**",
      ".kindex/**",
      ".gitnexus/**"
    ]
  },
  "model": "omlx/Qwen3.8-27B-MLX-6bit",
  "small_model": "omlx/Qwen3.6-35B-A3B-MLX-mixed-4bit",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "agent": {
    "compaction": {
      "model": "omlx/Qwen3.6-35B-A3B-MLX-mixed-4bit"
    }
  }
}
