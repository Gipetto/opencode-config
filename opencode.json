{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8192
    },
    "buffer": 6000
  },
  "lsp": true,
  "mcp": {
    "safari-mcp": {
      "command": [
        "/usr/bin/safaridriver",
        "--mcp"
      ],
      "type": "local"
    },
    "gitnexus": {
      "command": [
        "gitnexus",
        "mcp"
      ],
      "type": "local"
    },
    "kindex": {
      "command": [
        "kin-mcp"
      ],
      "type": "local"
    },
    "postgres": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{file:secrets/postgres-url}"
      ],
      "type": "local"
    },
    "sentry": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "svelte": {
      "command": [
        "npx",
        "-y",
        "@sveltejs/mcp"
      ],
      "type": "local"
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh auth status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh browse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh gist list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh gist view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue assign *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue comment *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue create *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue edit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh label list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh release list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh release view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh repo list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh repo view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh run list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh run view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh run watch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh search *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh workflow list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh workflow view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/**/T/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/**/T/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Projects/quizstreak*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Projects/quizstreak*/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/skills/**/references/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/skills/**/references/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/**/references/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/**/references/**",
      "effect": "allow"
    },
    {
      "action": "postgres_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "safari-mcp_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "sentry_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "svelte_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugin": [
    [
      "./plugins/kindex-compaction",
      {
        "configPath": "../kindex/opencode.yaml",
        "env": {
          "ANTHROPIC_BASE_URL": "http://localhost:8000",
          "OMLX_KEY": "{file:secrets/omlx-key}"
        },
        "debug": true
      }
    ],
    "./plugins/kindex-memory"
  ],
  "provider": {
    "lmstudio": {
      "models": {},
      "name": "LM Studio (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseUrl": "http://127.0.0.1:1234/v1"
      }
    },
    "omlx": {
      "models": {
        "Qwen3.8-27B-8bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q8 (omlx)",
          "options": {}
        },
        "Qwen3.8-27B-MLX-6bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q6 (omlx)",
          "options": {},
          "variants": {}
        },
        "Qwen3.8-27B-MLX-6bit-32k": {
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q6 32k context (omlx)",
          "id": "Qwen3.8-27B-MLX-6bit-32k",
          "options": {},
          "variants": {}
        },
        "Qwen3.8-27B-MLX-4bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.8 27B Q4 (omlx)",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit": {
          "limit": {
            "context": 150000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE (omlx)",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit-32k": {
          "limit": {
            "context": 32000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE 32k context (omlx)",
          "id": "Qwen3.6-35B-A3B-MLX-mixed-4bit",
          "options": {}
        },
        "Qwen3.6-35B-A3B-MLX-mixed-4bit-64k": {
          "limit": {
            "context": 64000,
            "output": 4096
          },
          "name": "Qwen 3.6 35B A3B MoE 64k context (omlx)",
          "id": "Qwen3.6-35B-A3B-MLX-mixed-4bit",
          "options": {}
        },
        "Qwen3.8-Flash-Next-oQ4e-mtp": {
          "limit": {
            "context": 150000,
            "output": 16384
          },
          "options": {}
        }
      },
      "name": "OMLX (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{file:secrets/omlx-api-key}",
        "baseURL": "http://127.0.0.1:8000/v1"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".turbo/**",
      ".next/**",
      ".sveltekit/**",
      ".kindex/**",
      ".gitnexus/**"
    ]
  },
  "model": "omlx/Qwen3.8-Flash-Next-oQ4e-mtp",
  "default_agent": "orchestrator",
  "experimental": {
    "subagent_depth": 1
  },
  "agent": {},
  "shell": "zsh"
}
